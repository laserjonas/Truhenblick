# Vorlage für die Konfiguration mit Docker Compose.
# Kopieren nach .env und anpassen:   cp .env.example .env

# --- Web-App -----------------------------------------------------------------

# Unter welcher Adresse (z. B. truhe.example.de) der Server erreichbar ist, ob ein Reverse Proxy
# davor sitzt und ob man sich mit einem Passwort anmelden muss, wird nicht hier eingestellt,
# sondern in der App: Einstellungen → Server. (SITE_ADDRESS aus älteren Fassungen entfällt.)

# Auf welcher Adresse und welchem Port des Rechners die App erreichbar ist.
# Hinter einem Reverse Proxy auf demselben Rechner: HTTP_BIND=127.0.0.1 und z. B. HTTP_PORT=8080
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# Nur mit docker-compose.https.yml – wenn Truhenblick selbst ein Zertifikat holen soll
HTTPS_PORT=443

# --- Sync-Backend (nur mit --profile sync) -----------------------------------

# Zugangscodes entstehen in der App: Wer dort eine Truhe anlegt, bekommt einen Code,
# mit dem weitere Geräte beitreten. Hier muss dafür nichts eingetragen werden.

# Dürfen in der App neue Truhen angelegt werden? (an/aus) Jeder, der den Server erreicht,
# kann sonst eine eigene, leere Truhe beginnen – an fremde kommt er ohne deren Code nicht.
# Für Server im Internet: nach dem Anlegen der eigenen Truhe auf „aus“ stellen.
NEUE_TRUHEN=an

# Höchstzahl der Truhen auf diesem Server
MAX_TRUHEN=10

# Freiwillig: Zugangscode der zuerst angelegten Truhe, mindestens 16 Zeichen.
# Nützlich, um ihn zurückzusetzen, wenn kein Gerät ihn mehr kennt (neuen Wert eintragen, neu starten).
SYNC_TOKEN=

# Nur nötig, wenn die Web-App von einer ANDEREN Adresse geladen wird als das Backend
# (z. B. App auf einem statischen Hoster). Mehrere Adressen mit Komma trennen.
# CORS_ORIGIN=https://truhe.example.de
CORS_ORIGIN=
