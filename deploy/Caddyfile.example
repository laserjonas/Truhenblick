# Beispiel für einen Reverse Proxy mit HTTPS vor Truhenblick (Caddy auf dem Host, z. B. Ubuntu-VPS).
#
# Voraussetzungen:
#   - Die Domain zeigt per DNS auf diesen Server, Ports 80 und 443 sind offen.
#   - Truhenblick lauscht lokal, z. B. mit HTTP_BIND=127.0.0.1 und HTTP_PORT=8080 in der .env
#     (Docker Compose) oder als LXC unter http://<IP-des-Containers>:80.
#
# Einbinden:  Inhalt nach /etc/caddy/Caddyfile übernehmen, dann  sudo systemctl reload caddy
# Caddy besorgt und erneuert das Zertifikat von Let's Encrypt automatisch.

truhe.example.de {
	encode zstd gzip

	# Docker Compose auf demselben Rechner:
	reverse_proxy 127.0.0.1:8080

	# Proxmox-LXC im Heimnetz stattdessen:
	# reverse_proxy 192.168.1.50:80
}

# ---------------------------------------------------------------------------
# Variante ohne Docker: App als statische Dateien, Backend als systemd-Dienst
# (so richtet es auch das Proxmox-Skript im Container ein).
#
# truhe.example.de {
# 	encode zstd gzip
#
# 	handle /api/* {
# 		reverse_proxy 127.0.0.1:3000
# 	}
#
# 	handle {
# 		root * /var/www/truhenblick
# 		@frisch path / /index.html /sw.js /registerSW.js /manifest.webmanifest
# 		header @frisch Cache-Control "no-cache"
# 		try_files {path} /index.html
# 		file_server
# 	}
# }
