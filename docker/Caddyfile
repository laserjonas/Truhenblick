# Caddy im Truhenblick-Container: liefert die App aus und reicht /api an das Sync-Backend weiter.
#
# Hier steht bewusst keine Adresse. Port 80 antwortet unter jedem Namen – der IP im Heimnetz
# genauso wie dem Namen, unter dem ein vorgeschalteter Reverse Proxy (z. B. Nginx Proxy Manager)
# die App erreichbar macht. Welche Adresse gilt, wird in der App eingestellt:
# Einstellungen → Server.
#
# Port 443 ist für „Truhenblick holt das Zertifikat selbst“ da: Caddy fragt beim Backend nach,
# ob er für den angefragten Namen eines holen darf, und tut es nur für die eingestellte Adresse.
{
	on_demand_tls {
		ask http://{$API_UPSTREAM:api:3000}/api/zertifikat
	}
}

(truhenblick) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Sync-Backend (optional). Läuft es nicht, antwortet Caddy hier mit 502 –
	# die App funktioniert trotzdem vollständig lokal.
	handle /api/* {
		# Die Rückfrage von oben ist nur für Caddy selbst gedacht.
		@intern path /api/zertifikat
		respond @intern 404

		reverse_proxy {$API_UPSTREAM:api:3000} {
			# Einem Reverse Proxy im privaten Netz glauben, von welchem Gerät eine Anfrage stammt.
			trusted_proxies private_ranges
		}
	}

	handle {
		root * /srv

		# Einstiegsseite, Manifest und Service Worker immer neu prüfen, sonst kommen Updates nicht an.
		@frisch path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @frisch Cache-Control "no-cache"

		# Manche Proxys speichern .js-Dateien zwischen, was auch immer oben steht (in Nginx Proxy
		# Manager: „Cache Assets“). „Vary: *“ verbietet ihnen das für den Service Worker.
		header /sw.js {
			Vary "*"
			defer
		}

		# Dateien unter /assets tragen einen Hash im Namen und ändern sich nie.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}

:80 {
	import truhenblick
}

https:// {
	tls {
		on_demand
	}

	import truhenblick
}
